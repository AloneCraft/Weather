+                    expectedLength=1000;
+                }
+                if(entry.Body.Length==expectedLength&&entry.Body.All(b=>b==(byte)tag)){
+                    Interlocked.Increment(ref valid);
+                }else{
+                    Interlocked.Increment(ref torn);
+                }
+            }
+        },ct)).ToArray();
+        await writer;
+        await Task.WhenAll(readers);
