<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 対象は iOS / Android のみ(SolutionStructure.md)。iOS のパッケージ作成・署名には Mac が必要 -->
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Weather.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- コンパイル済みバインディングを必須にする(Screens.md「MAUI 固有の注意点」) -->
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <ApplicationTitle>空模様</ApplicationTitle>
    <ApplicationId>io.github.alonecraft.soramoyou</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);XC0103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E6CCC" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1D2B5A" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- 背景更新(WorkManager。ウィジェット・警報の通知) -->
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- SKMetalView(iOS の Metal 描画ホスト。Rendering.md「描画ホスト」) -->
    <PackageReference Include="SkiaSharp.Views" />
  </ItemGroup>

  <!--
    Android のリリース署名(ストア提出用)。鍵はリポジトリに置かず環境変数で渡す。未設定ならデバッグ鍵で署名される
      WEATHER_ANDROID_KEYSTORE        キーストアのパス
      WEATHER_ANDROID_KEY_ALIAS       鍵の別名
      WEATHER_ANDROID_STORE_PASSWORD  キーストアのパスワード(env: で参照し、ビルドログに出さない)
      WEATHER_ANDROID_KEY_PASSWORD    鍵のパスワード
    iOS の署名は Mac で CodesignKey / CodesignProvision を指定する(README.md)
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(WEATHER_ANDROID_KEYSTORE)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(WEATHER_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(WEATHER_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:WEATHER_ANDROID_STORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:WEATHER_ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <!--
    iOS のウィジェット(WidgetKit 拡張。Swift)は任意で同梱する: -p:IncludeWidgetExtension=true
    事前に Mac で src/Weather.Widget.iOS をビルドしておく(README.md)。App Group を有効にしたプロビジョニングが必要なため既定では含めない
  -->
  <PropertyGroup Condition="'$(IncludeWidgetExtension)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.Widget.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeWidgetExtension)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <AdditionalAppExtensions Include="$(MSBuildProjectDirectory)/../Weather.Widget.iOS">
      <Name>WeatherWidget</Name>
      <BuildOutput Condition="'$(ComputedPlatform)' == 'iPhone'">build/Release-iphoneos</BuildOutput>
      <BuildOutput Condition="'$(ComputedPlatform)' == 'iPhoneSimulator'">build/Release-iphonesimulator</BuildOutput>
    </AdditionalAppExtensions>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weather.Core\Weather.Core.csproj" />
    <ProjectReference Include="..\Weather.Providers\Weather.Providers.csproj" />
    <ProjectReference Include="..\Weather.Geo\Weather.Geo.csproj" />
    <ProjectReference Include="..\Weather.Scene\Weather.Scene.csproj" />
    <ProjectReference Include="..\Weather.Rendering\Weather.Rendering.csproj" />
    <ProjectReference Include="..\Weather.Infrastructure\Weather.Infrastructure.csproj" />
    <ProjectReference Include="..\Weather.Presentation\Weather.Presentation.csproj" />
  </ItemGroup>
</Project>
