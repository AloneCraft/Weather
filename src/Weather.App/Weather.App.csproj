<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 対象は iOS / Android のみ(SolutionStructure.md)。iOS のパッケージ作成・署名には Mac が必要 -->
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Weather.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- コンパイル済みバインディングを必須にする(Screens.md「MAUI 固有の注意点」) -->
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <ApplicationTitle>空模様</ApplicationTitle>
    <ApplicationId>io.github.alonecraft.soramoyou</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);XC0103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2E6CCC" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1D2B5A" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- 背景更新(WorkManager。ウィジェット・警報の通知) -->
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" />
    <!-- 広告・同意・課金(Monetization.md) -->
    <PackageReference Include="Xamarin.GooglePlayServices.Ads" />
    <PackageReference Include="Xamarin.Google.UserMessagingPlatform" />
    <PackageReference Include="Xamarin.Android.Google.BillingClient" />
    <!-- 広告 SDK に合わせて AndroidX の版を揃える(Directory.Packages.props) -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Service" />
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- SKMetalView(iOS の Metal 描画ホスト。Rendering.md「描画ホスト」) -->
    <PackageReference Include="SkiaSharp.Views" />
  </ItemGroup>

  <!--
    AdMob の ID(Monetization.md)。本番の ID はリポジトリに置かず環境変数で渡す(AdMob の管理画面で作成する)
      WEATHER_ADMOB_ANDROID_APP_ID / WEATHER_ADMOB_ANDROID_BANNER_ID   Android のアプリ ID / バナーの広告ユニット ID
      WEATHER_ADMOB_IOS_APP_ID / WEATHER_ADMOB_IOS_BANNER_ID           iOS の同上
    Debug は Google のテスト用 ID。Release で未設定(またはテスト用 ID)ならビルドを失敗させる(テスト広告のまま提出しない)。
    Release をエミュレーターで試すときだけ -p:UseTestAds=true でテスト用 ID を使える
    同意フォームの試験: -p:AdsDebugGeography=EEA(-p:AdsTestDeviceHashedId=<logcat に出る ID>)。Debug でだけ有効
  -->
  <PropertyGroup>
    <AdMobTestPublisher>ca-app-pub-3940256099942544</AdMobTestPublisher>
    <UseTestAds Condition="'$(UseTestAds)' == '' And '$(Configuration)' != 'Release'">true</UseTestAds>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AdMobAppId>$(WEATHER_ADMOB_ANDROID_APP_ID)</AdMobAppId>
    <AdMobBannerUnitId>$(WEATHER_ADMOB_ANDROID_BANNER_ID)</AdMobBannerUnitId>
    <AdMobAppId Condition="'$(UseTestAds)' == 'true'">$(AdMobTestPublisher)~3347511713</AdMobAppId>
    <AdMobBannerUnitId Condition="'$(UseTestAds)' == 'true'">$(AdMobTestPublisher)/9214589741</AdMobBannerUnitId>
    <!-- AndroidManifest.xml の ${admobAppId} -->
    <AndroidManifestPlaceholders>admobAppId=$(AdMobAppId)</AndroidManifestPlaceholders>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <AdMobAppId>$(WEATHER_ADMOB_IOS_APP_ID)</AdMobAppId>
    <AdMobBannerUnitId>$(WEATHER_ADMOB_IOS_BANNER_ID)</AdMobBannerUnitId>
    <AdMobAppId Condition="'$(UseTestAds)' == 'true'">$(AdMobTestPublisher)~1458002511</AdMobAppId>
    <AdMobBannerUnitId Condition="'$(UseTestAds)' == 'true'">$(AdMobTestPublisher)/2435281174</AdMobBannerUnitId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AdsDebugGeography></AdsDebugGeography>
    <AdsTestDeviceHashedId></AdsTestDeviceHashedId>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AdMobBannerUnitId" Value="$(AdMobBannerUnitId)" />
    <AssemblyMetadata Include="AdsDebugGeography" Value="$(AdsDebugGeography)" />
    <AssemblyMetadata Include="AdsTestDeviceHashedId" Value="$(AdsTestDeviceHashedId)" />
  </ItemGroup>
  <Target Name="CheckAdMobIds" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' != ''">
    <Error Condition="'$(AdMobAppId)' == '' Or '$(AdMobBannerUnitId)' == ''" Text="AdMob の ID が未設定です。Release では WEATHER_ADMOB_*(Weather.App.csproj の説明)を設定するか、動作確認だけなら -p:UseTestAds=true を付けてください" />
    <Error Condition="'$(UseTestAds)' != 'true' And ($(AdMobAppId.StartsWith('$(AdMobTestPublisher)')) Or $(AdMobBannerUnitId.StartsWith('$(AdMobTestPublisher)')))" Text="Release に Google のテスト用 AdMob ID が設定されています" />
    <Warning Condition="'$(Configuration)' == 'Release' And '$(UseTestAds)' == 'true'" Code="WEATHER0001" Text="テスト用の AdMob ID でビルドしています(ストアには提出しないでください)" />
  </Target>

  <!--
    Android のリリース署名(ストア提出用)。鍵はリポジトリに置かず環境変数で渡す。未設定ならデバッグ鍵で署名される
      WEATHER_ANDROID_KEYSTORE        キーストアのパス
      WEATHER_ANDROID_KEY_ALIAS       鍵の別名
      WEATHER_ANDROID_STORE_PASSWORD  キーストアのパスワード(env: で参照し、ビルドログに出さない)
      WEATHER_ANDROID_KEY_PASSWORD    鍵のパスワード
    iOS の署名は Mac で CodesignKey / CodesignProvision を指定する(README.md)
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(WEATHER_ANDROID_KEYSTORE)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(WEATHER_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(WEATHER_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:WEATHER_ANDROID_STORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:WEATHER_ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <!--
    iOS のウィジェット(WidgetKit 拡張。Swift)は任意で同梱する: -p:IncludeWidgetExtension=true
    事前に Mac で src/Weather.Widget.iOS をビルドしておく(README.md)。App Group を有効にしたプロビジョニングが必要なため既定では含めない
  -->
  <PropertyGroup Condition="'$(IncludeWidgetExtension)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.Widget.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeWidgetExtension)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <AdditionalAppExtensions Include="$(MSBuildProjectDirectory)/../Weather.Widget.iOS">
      <Name>WeatherWidget</Name>
      <BuildOutput Condition="'$(ComputedPlatform)' == 'iPhone'">build/Release-iphoneos</BuildOutput>
      <BuildOutput Condition="'$(ComputedPlatform)' == 'iPhoneSimulator'">build/Release-iphonesimulator</BuildOutput>
    </AdditionalAppExtensions>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weather.Core\Weather.Core.csproj" />
    <ProjectReference Include="..\Weather.Providers\Weather.Providers.csproj" />
    <ProjectReference Include="..\Weather.Geo\Weather.Geo.csproj" />
    <ProjectReference Include="..\Weather.Scene\Weather.Scene.csproj" />
    <ProjectReference Include="..\Weather.Rendering\Weather.Rendering.csproj" />
    <ProjectReference Include="..\Weather.Infrastructure\Weather.Infrastructure.csproj" />
    <ProjectReference Include="..\Weather.Presentation\Weather.Presentation.csproj" />
  </ItemGroup>
</Project>
