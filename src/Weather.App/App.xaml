<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Weather.App"
             x:Class="Weather.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BackgroundToTextColorConverter x:Key="TextColor" />
            <local:BackgroundToCardColorConverter x:Key="CardColor" />
            <local:AlertTierToColorConverter x:Key="TierColor" />
            <local:HasValueConverter x:Key="HasValue" />
            <local:InvertBoolConverter x:Key="Invert" />
            <local:HasDataStateConverter x:Key="HasData" />
            <local:HistoryRangeToIndexConverter x:Key="RangeIndex" />

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,6" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Opacity" Value="0.85" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.8" />
            </Style>
            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#33000000" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="MinimumHeightRequest" Value="34" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
