<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Weather.Presentation.Resources;assembly=Weather.Presentation"
             xmlns:vm="clr-namespace:Weather.Presentation.ViewModels;assembly=Weather.Presentation"
             x:Class="Weather.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static res:Strings.Settings}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static res:Strings.UseImperial}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UseImperial}" />
            </Grid>
            <VerticalStackLayout>
                <Label Text="{x:Static res:Strings.RenderQualityLabel}" />
                <Picker ItemsSource="{x:Static vm:SettingsViewModel.QualityOptions}" SelectedIndex="{Binding QualityIndex}" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static res:Strings.ReduceFlashes}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding ReduceFlashes}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static res:Strings.PowerSaving}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding PowerSaving}" />
            </Grid>
            <VerticalStackLayout>
                <Label Text="{x:Static res:Strings.RetentionLabel}" />
                <Picker ItemsSource="{x:Static vm:SettingsViewModel.RetentionOptions}" SelectedIndex="{Binding RetentionIndex}" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static res:Strings.AlertNotificationsLabel}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding AlertNotifications}" />
            </Grid>
            <Label Text="{x:Static res:Strings.AlertNotificationsNote}" FontSize="12" Opacity="0.7" />
            <Label Text="{x:Static res:Strings.WidgetSettingsNote}" FontSize="12" Opacity="0.7" />
            <!-- 広告(Monetization.md)。BindingContext は AdSettingsViewModel(コードビハインドで設定) -->
            <VerticalStackLayout x:Name="AdsSection" x:DataType="vm:AdSettingsViewModel" Spacing="8">
                <Label Text="{x:Static res:Strings.AdsSection}" FontAttributes="Bold" />
                <Label Text="{x:Static res:Strings.AdFreeActive}" IsVisible="{Binding IsAdFree}" FontSize="12" Opacity="0.7" />
                <Label Text="{x:Static res:Strings.AdsNote}" IsVisible="{Binding IsAdFree, Converter={StaticResource Invert}}" FontSize="12" Opacity="0.7" />
                <Button Text="{Binding PurchaseText}" Command="{Binding PurchaseCommand}" IsVisible="{Binding CanPurchase}" />
                <Button Text="{x:Static res:Strings.RestorePurchases}" Command="{Binding RestoreCommand}" IsVisible="{Binding IsAdFree, Converter={StaticResource Invert}}" />
                <Button Text="{x:Static res:Strings.AdPrivacyOptions}" Command="{Binding OpenPrivacyOptionsCommand}" IsVisible="{Binding IsPrivacyOptionsRequired}" />
            </VerticalStackLayout>
            <Button Text="{x:Static res:Strings.DeleteHistory}" Command="{Binding DeleteHistoryCommand}" />
            <Button Text="{x:Static res:Strings.DataAndSources}" Command="{Binding OpenAboutCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
