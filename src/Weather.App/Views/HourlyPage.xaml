<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:Weather.Presentation.Resources;assembly=Weather.Presentation"
             xmlns:vm="clr-namespace:Weather.Presentation.ViewModels;assembly=Weather.Presentation"
             xmlns:controls="clr-namespace:Weather.App.Controls"
             x:Class="Weather.App.Views.HourlyPage"
             x:DataType="vm:HourlyViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0B1026">
    <Grid RowDefinitions="220,Auto,Auto,*,Auto">
        <!-- グラフをドラッグするとシーンの時刻が動く -->
        <controls:SceneView x:Name="Scene" Grid.Row="0" Scene="{Binding Scene}" />
        <Label Grid.Row="0" Text="{Binding ScrubText}" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="16" VerticalOptions="End" />
        <controls:ChartView x:Name="Chart" Grid.Row="1" HeightRequest="190" Points="{Binding Chart}" Cursor="{Binding ScrubTime}" />
        <Label Grid.Row="2" Text="{x:Static res:Strings.ScrubHint}" FontSize="11" TextColor="#B0BEC5" Margin="12,0" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Hours}" Margin="12,4">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HourItem">
                    <Grid ColumnDefinitions="56,36,60,50,*" Padding="0,6">
                        <Label Grid.Column="0" Text="{Binding TimeText}" TextColor="White" />
                        <Label Grid.Column="1" Text="{Binding Icon}" FontSize="18" />
                        <Label Grid.Column="2" Text="{Binding Temperature}" TextColor="White" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="{Binding Probability}" TextColor="#90CAF9" />
                        <Label Grid.Column="4" Text="{Binding Text}" TextColor="#CFD8DC" FontSize="12" LineBreakMode="TailTruncation" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Grid.Row="4" Text="{Binding Attribution}" Style="{StaticResource Caption}" TextColor="#B0BEC5" Margin="12,4,12,16" />
    </Grid>
</ContentPage>
