<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Weather.Presentation.ViewModels;assembly=Weather.Presentation"
             x:Class="Weather.App.Views.AlertDetailPage"
             x:DataType="vm:AlertDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="#102040">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding Title}" TextColor="White" FontSize="22" FontAttributes="Bold" />
            <Label Text="{Binding Area}" TextColor="#CFD8DC" IsVisible="{Binding Area, Converter={StaticResource HasValue}}" />
            <Label Text="{Binding Headline}" TextColor="White" IsVisible="{Binding Headline, Converter={StaticResource HasValue}}" />
            <Label Text="{Binding Description}" TextColor="#ECEFF1" IsVisible="{Binding Description, Converter={StaticResource HasValue}}" />
            <Label Text="{Binding Instruction}" TextColor="#FFE082" IsVisible="{Binding Instruction, Converter={StaticResource HasValue}}" />
            <Label Text="{Binding Office}" Style="{StaticResource Caption}" TextColor="#B0BEC5" IsVisible="{Binding Office, Converter={StaticResource HasValue}}" />
            <Label Text="{Binding Attribution}" Style="{StaticResource Caption}" TextColor="#B0BEC5" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
