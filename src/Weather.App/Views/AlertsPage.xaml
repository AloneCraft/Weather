<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Weather.Presentation.ViewModels;assembly=Weather.Presentation"
             x:Class="Weather.App.Views.AlertsPage"
             x:DataType="vm:AlertsViewModel"
             Title="{Binding Title}"
             BackgroundColor="#102040">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">
        <Label Grid.Row="0" Text="{Binding Headline}" IsVisible="{Binding Headline, Converter={StaticResource HasValue}}" TextColor="White" FontSize="14" Margin="0,0,0,8" />
        <Label Grid.Row="1" Text="{Binding Message}" IsVisible="{Binding Message, Converter={StaticResource HasValue}}" TextColor="#CFD8DC" FontSize="15" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AlertItem">
                    <Border Style="{StaticResource Card}" BackgroundColor="{Binding Tier, Converter={StaticResource TierColor}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, Path=OpenCommand, x:DataType=vm:AlertsViewModel}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" TextColor="White" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Status}" TextColor="White" FontSize="12" />
                            <Label Text="{Binding Area}" TextColor="White" FontSize="12" IsVisible="{Binding Area, Converter={StaticResource HasValue}}" />
                            <Label Text="{Binding Period}" TextColor="White" FontSize="12" IsVisible="{Binding Period, Converter={StaticResource HasValue}}" />
                            <Label Text="{Binding Source}" TextColor="White" FontSize="11" Opacity="0.8" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Grid.Row="3" Text="{Binding Attribution}" Style="{StaticResource Caption}" TextColor="#B0BEC5" />
    </Grid>
</ContentPage>
