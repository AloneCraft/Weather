<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Weather.Rendering</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Weather.Scene\Weather.Scene.csproj" />
    <ProjectReference Include="..\Weather.Geo\Weather.Geo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scene\Shaders\*.sksl" LogicalName="Weather.Rendering.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Map\Shaders\*.sksl" LogicalName="Weather.Rendering.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Weather.Rendering.Tests" />
  </ItemGroup>
</Project>
