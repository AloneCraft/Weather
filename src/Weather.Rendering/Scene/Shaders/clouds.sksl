// 雲(Rendering.md「SkSL シェーダー」)。OCTAVES は品質段階ごとに置き換えてコンパイルする。
uniform float2 uResolution;
uniform float uTime;
uniform float uCover;      // 0..1
uniform float uDarkness;   // 0..1
uniform float2 uWind;      // 画面座標系の流れ
uniform float3 uLight;     // 日の当たる面の色
uniform float3 uShadow;    // 影の色
uniform float uScale;      // 模様の大きさ
uniform float uSeed;
uniform float uTop;        // 雲の帯の上端(0..1、画面高さ比)
uniform float uBottom;     // 雲の帯の下端

float hash(float2 p){ return fract(sin(dot(p,float2(127.1,311.7))+uSeed)*43758.5453); }

float noise(float2 p){
    float2 i=floor(p);
    float2 f=fract(p);
    float2 u=f*f*(3.0-2.0*f);
    return mix(mix(hash(i),hash(i+float2(1,0)),u.x),mix(hash(i+float2(0,1)),hash(i+float2(1,1)),u.x),u.y);
}

float fbm(float2 p){
    float v=0.0;
    float a=0.5;
    for(int i=0;i<OCTAVES;i++){
        v+=a*noise(p);
        p=p*2.03+float2(17.0,9.0);
        a*=0.5;
    }
    return v;
}

half4 main(float2 coord){
    float2 uv=coord/uResolution.y;
    float y=coord.y/uResolution.y;
    float band=smoothstep(uTop-0.05,uTop+0.15,y)*(1.0-smoothstep(uBottom-0.15,uBottom,y));
    float2 p=uv*uScale+uWind*uTime;
    float n=fbm(p);
    float threshold=1.0-uCover;
    float d=smoothstep(threshold-0.05,threshold+0.25,n)*band;
    float shade=fbm(p+float2(0.35,0.35));
    float3 col=mix(uLight,uShadow,clamp(shade*0.8+uDarkness*0.7,0.0,1.0));
    float alpha=clamp(d*(0.75+uCover*0.25),0.0,1.0);
    return half4(half3(col*alpha),half(alpha));
}
