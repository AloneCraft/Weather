<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Weather.Geo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Weather.Core\Weather.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- GeoDataBuilder が生成する地理データ(CacheAndRouting.md「地理データ」) -->
    <EmbeddedResource Include="Data\*.bin" LogicalName="Weather.Geo.Data.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Weather.Geo.Tests" />
    <InternalsVisibleTo Include="Weather.GeoDataBuilder" />
    <InternalsVisibleTo Include="Weather.Rendering" />
  </ItemGroup>
</Project>
