<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MauiVersion>10.0.110</MauiVersion>
    <SkiaSharpVersion>4.153.1</SkiaSharpVersion>
    <MicrosoftExtensionsVersion>10.0.12</MicrosoftExtensionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- MAUI -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- SkiaSharp(Rendering.md: 4.x に一元固定) -->
    <PackageVersion Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Views" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="$(SkiaSharpVersion)" />
    <!-- Phase 4: Azure Functions(isolated worker。Worker 2.52.0 は net10.0 対応) -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <!-- Android の背景更新(ウィジェット・警報の通知) -->
    <PackageVersion Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
    <!-- Phase 6: 広告(AdMob)・同意(UMP)・課金(Play Billing)。試作 A1 で版を決める -->
    <PackageVersion Include="Xamarin.GooglePlayServices.Ads" Version="125.5.0" />
    <PackageVersion Include="Xamarin.Google.UserMessagingPlatform" Version="4.0.0.4" />
    <PackageVersion Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
    <!-- 広告 SDK が MAUI 10.0.110 より新しい AndroidX(Lifecycle 2.11 等)を要求するため、MAUI が引き込む古い版を明示的に揃える(試作 A1) -->
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Service" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MicrosoftExtensionsVersion)" />

    <!-- 永続化 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />

    <!-- 解析 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

    <!-- テスト -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
  </ItemGroup>
</Project>
